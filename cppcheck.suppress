// Just a report of how many checkers are run
checkersReport

// This just warns that cppcheck isn't exhaustive and it still appears in exhaustive mode
normalCheckLevelMaxBranches

missingIncludeSystem
useInitializationList

// Causes false positives
unusedStructMember
functionStatic
derefInvalidIteratorRedundantCheck
unmatchedSuppression

// matchit causes issues with cppcheck
syntaxError

// Ignore debug methods
unusedFunction

// libpython uses this a lot, unfortunately
cstyleCast

// ignore dependencies
*:*json*
*:*test*
*:*python*
*:*cpm_modules*
*:*_deps*
// Preferences rather than defects
//   variableScope        declarations kept at the top of a function body
//   unusedPrivateFunction  a private helper kept for a later pass
//   useStlAlgorithm      a raw loop reads better than an accumulate here
variableScope
unusedPrivateFunction
useStlAlgorithm
